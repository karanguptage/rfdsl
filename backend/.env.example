DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=RFDSL
ADMIN_PASSWORD=change-me
SECRET_KEY=generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_TOKEN_HOURS=8
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Contact form email
SMTP_HOST=mail.example.co.nz
SMTP_PORT=587
SMTP_USER=info@example.co.nz
SMTP_PASSWORD=change-me
CONTACT_EMAIL_FROM=info@example.co.nz
CONTACT_EMAIL_TO=info@example.co.nz

# Servers allowed to pass the visitor IP to the API (the Next.js site).
TRUSTED_PROXIES=127.0.0.1,::1

# Nemanja (AI consultant on /solutions)
AI_PROVIDER=openai_compatible              # none | openai_compatible
AI_API_KEY=
AI_MODEL=gpt-4o-mini
#AI_WORKSPACE_ID=
AI_BASE_URL=https://api.openai.com/v1                 # required for openai_compatible
AI_TOKEN_LIMIT_PARAM=auto                  # not used (the Responses API sizes replies itself)
#AI_EFFORT=medium                          # reasoning models only; leave off for gpt-4o-mini
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_INPUT_COST_PER_MTOK=0.15    # used only for cost estimates
AI_OUTPUT_COST_PER_MTOK=0.60
# Usage limit per chat (input + output tokens); beyond it the chat goes to staff
NEMANJA_MAX_TOKENS_PER_CHAT=1000000
# Public address of the website (links in staff alert emails)
PUBLIC_SITE_URL=https://www.rfdsl.co.nz
